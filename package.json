{
  "name": "TET",
  "version": "0.1.0",
  "description": "TET provider for Magpie: Responses models, wallet balance and API key usage",
  "type": "module",
  "packageManager": "bun@1.3.13",
  "main": "./index.mjs",
  "files": [
    "index.mjs",
    "src",
    "assets/logo.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "check": "node scripts/check-package.mjs",
    "sync-icon": "node scripts/sync-icon.mjs",
    "test:host": "bun scripts/smoke/host.mjs",
    "test:relay": "bun scripts/smoke/relay.mjs",
    "prepack": "node scripts/check-package.mjs"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "magpie",
    "magpie-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/xgxg-mdl/magpie-tet.git"
  },
  "license": "MIT",
  "exports": "./index.mjs",
  "engines": {
    "node": ">=22"
  },
  "magpie": {
    "options": {
      "queryTimeoutMs": 15000,
      "showTraffic": true,
      "excludeModels": [],
      "modelOverrides": {}
    },
    "icon": "data:image/svg+xml;base64,"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10"
  }
}
