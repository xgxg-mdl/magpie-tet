{
  "name": "TET",
  "version": "1.0.0",
  "description": "TET provider for Magpie: model discovery, configurable protocols, wallet balance and API key usage",
  "type": "module",
  "packageManager": "bun@1.3.13",
  "main": "./src/index.ts",
  "files": [
    "src",
    "assets/logo.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "build": "bun run typecheck && bun scripts/build.mjs",
    "check:build": "bun scripts/build.mjs --check",
    "check:architecture": "node scripts/checks/architecture.mjs",
    "check:local-materials": "node scripts/checks/local-materials.mjs",
    "check:commit-message": "node scripts/checks/commit-message.mjs",
    "check:syntax": "node scripts/checks/syntax.mjs",
    "check:package": "node scripts/checks/package.mjs",
    "check": "bun run check:local-materials && bun run check:architecture && bun run check:syntax && bun run build",
    "check:release": "bun run release:prepare && bun run check:package",
    "release:prepare": "node scripts/release/prepare.mjs",
    "sync-icon": "node scripts/sync-icon.mjs",
    "test": "bun test",
    "test:host": "bun scripts/host/verify.mjs",
    "test:relay": "bun scripts/diagnostics/relay.mjs",
    "prepack": "bun run check && bun run check:release"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "magpie",
    "magpie-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/xgxg-mdl/magpie-tet.git"
  },
  "license": "MIT",
  "exports": "./src/index.ts",
  "engines": {
    "node": ">=22"
  },
  "magpie": {
    "options": {
      "queryTimeoutMs": 15000,
      "showTraffic": true,
      "excludeModels": [],
      "modelOverrides": {}
    },
    "icon": "data:image/svg+xml;base64,"
  },
  "devDependencies": {
    "@types/bun": "1.3.0",
    "@types/node": "22.18.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "5.9.3"
  }
}
